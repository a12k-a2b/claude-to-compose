{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-to-compose.local/schemas/v1/behavior-manifest.schema.json",
  "title": "Authored behavior manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "appModelSha256", "designSpecSha256", "correspondenceSha256", "scenes", "scenarios", "states", "preservationObligations", "acceptanceRequirements", "implementationBoundary", "goldenPolicy", "ownerApprovals"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "kind": { "const": "BehaviorManifest" }, "id": { "$ref": "#/$defs/id" },
    "appModelSha256": { "$ref": "#/$defs/sha256" }, "designSpecSha256": { "$ref": "#/$defs/sha256" },
    "correspondenceSha256": { "$ref": "#/$defs/sha256" },
    "scenes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "scenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "preservationObligations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/obligation" } },
    "acceptanceRequirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "implementationBoundary": { "$ref": "#/$defs/boundary" },
    "goldenPolicy": { "$ref": "#/$defs/goldenPolicy" },
    "ownerApprovals": { "type": "array", "items": { "$ref": "#/$defs/approval" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#()\\[\\]-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nonEmpty": { "type": "string", "minLength": 1 },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "statement", "status", "sourceEvidenceRefs", "verificationRequirement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["LAUNCH_RESTORE", "NAVIGATION", "DATA_CRUD", "PERSISTENCE", "ERROR_RETRY_OFFLINE", "INPUT_FOCUS", "PROCESS_LIFECYCLE", "RESPONSIVE_LAYOUT", "ACCESSIBILITY", "DESTRUCTIVE_RECOVERY", "SYNC", "OTHER"] },
        "statement": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["REQUIRED", "OWNER_APPROVED_CHANGE"] },
        "sourceEvidenceRefs": { "$ref": "#/$defs/refs" }, "verificationRequirement": { "$ref": "#/$defs/nonEmpty" },
        "ownerApprovalRef": { "$ref": "#/$defs/id" }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "OWNER_APPROVED_CHANGE" } }, "required": ["status"] }, "then": { "required": ["ownerApprovalRef"] }, "else": { "not": { "required": ["ownerApprovalRef"] } } }]
    },
    "viewport": {
      "type": "object", "additionalProperties": false, "required": ["widthPx", "heightPx", "deviceScaleFactor"],
      "properties": { "widthPx": { "type": "integer", "minimum": 1 }, "heightPx": { "type": "integer", "minimum": 1 }, "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["buildVariant", "locale", "theme", "fontScale", "orientation", "reducedMotion"],
      "properties": {
        "buildVariant": { "$ref": "#/$defs/nonEmpty" }, "locale": { "$ref": "#/$defs/nonEmpty" }, "theme": { "$ref": "#/$defs/nonEmpty" },
        "fontScale": { "type": "number", "exclusiveMinimum": 0 }, "orientation": { "enum": ["PORTRAIT", "LANDSCAPE"] }, "reducedMotion": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sceneId", "scenarioId", "stateId", "viewport", "deviceProfile", "configuration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "sceneId": { "$ref": "#/$defs/id" }, "scenarioId": { "$ref": "#/$defs/id" }, "stateId": { "$ref": "#/$defs/id" },
        "viewport": { "$ref": "#/$defs/viewport" }, "deviceProfile": { "$ref": "#/$defs/nonEmpty" }, "configuration": { "$ref": "#/$defs/configuration" }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["id", "metric", "operator", "threshold", "unit"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "metric": { "$ref": "#/$defs/nonEmpty" }, "operator": { "enum": ["AT_LEAST", "AT_MOST", "EXACT"] }, "threshold": { "type": "number" }, "unit": { "$ref": "#/$defs/nonEmpty" } }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "domains", "requiredContexts", "numericBudgets", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/nonEmpty" },
        "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["BUILD", "BEHAVIOR", "RENDER", "SEMANTICS", "PERFORMANCE", "PROVENANCE", "OTHER"] } },
        "requiredContexts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/context" } },
        "numericBudgets": { "type": "array", "items": { "$ref": "#/$defs/budget" } }, "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["allowedPaths", "prohibitedChanges", "verificationCommands"],
      "properties": {
        "allowedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+/?$" }] } },
        "prohibitedChanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "verificationCommands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "goldenPolicy": {
      "type": "object", "additionalProperties": false, "required": ["status", "statement", "obligationRef"],
      "properties": { "status": { "enum": ["PRESERVE_EXISTING", "OWNER_APPROVED_CHANGE"] }, "statement": { "$ref": "#/$defs/nonEmpty" }, "obligationRef": { "$ref": "#/$defs/id" }, "ownerApprovalRef": { "$ref": "#/$defs/id" } },
      "allOf": [{ "if": { "properties": { "status": { "const": "OWNER_APPROVED_CHANGE" } }, "required": ["status"] }, "then": { "required": ["ownerApprovalRef"] }, "else": { "not": { "required": ["ownerApprovalRef"] } } }]
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
