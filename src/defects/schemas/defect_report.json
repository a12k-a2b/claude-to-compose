{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daylight.dev/schemas/ctc/v2/defect_report.json",
  "title": "DefectReport",
  "description": "Structured Causal Defect Report attributing verification failures directly to stable design element IDs, Kotlin AST targets, and actionable remediation diffs",
  "type": "object",
  "required": [
    "version",
    "screenId",
    "generatedAt",
    "gateOutcome",
    "summary",
    "defects",
    "blockers"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "screenId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "gateOutcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "summary": {
      "type": "object",
      "required": ["totalDefects", "bySeverity", "byCategory", "byRootCause"],
      "properties": {
        "totalDefects": { "type": "integer", "minimum": 0 },
        "bySeverity": {
          "type": "object",
          "required": ["critical", "major", "minor"],
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "major": { "type": "integer", "minimum": 0 },
            "minor": { "type": "integer", "minimum": 0 }
          }
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byRootCause": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": { "$ref": "#/$defs/DefectRecord" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "verificationRunId": { "type": ["string", "null"] },
        "contractHash": { "type": "string" },
        "targetAppRevision": { "type": "string" },
        "deviceProfile": { "type": "string" }
      }
    }
  },
  "$defs": {
    "DefectRecord": {
      "type": "object",
      "required": [
        "defectId",
        "category",
        "severity",
        "sourceId",
        "target",
        "diagnosis",
        "remediation"
      ],
      "properties": {
        "defectId": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "MISSING_ELEMENT",
            "MARGIN_SHIFT",
            "CONTRAST_FAILURE",
            "COLOR_COLLAPSE",
            "TOUCH_TARGET_TOO_SMALL",
            "INVARIANT_BROKEN",
            "EPD_FLASH_DETECTED",
            "LAYOUT_OVERFLOW",
            "ASSET_MISSING",
            "EVIDENCE_MISSING"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "MAJOR", "MINOR"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "required": ["file", "composable"],
          "properties": {
            "file": { "type": ["string", "null"] },
            "composable": { "type": ["string", "null"] },
            "line": { "type": ["integer", "null"] },
            "astNodeType": { "type": ["string", "null"] },
            "testTag": { "type": ["string", "null"] }
          }
        },
        "diagnosis": {
          "type": "object",
          "required": ["rootCause", "confidence", "explanation"],
          "properties": {
            "rootCause": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "explanation": { "type": "string" },
            "observedDelta": {
              "type": "object",
              "properties": {
                "dx": { "type": "number" },
                "dy": { "type": "number" },
                "drift": { "type": "number" },
                "contrastRatio": { "type": "number" },
                "touchWidthDp": { "type": "number" },
                "touchHeightDp": { "type": "number" },
                "settleMs": { "type": "number" }
              }
            },
            "expected": { "type": ["object", "string", "number", "null"] },
            "actual": { "type": ["object", "string", "number", "null"] }
          }
        },
        "remediation": {
          "type": "object",
          "required": ["action", "patchType", "targetFile"],
          "properties": {
            "action": { "type": "string" },
            "patchType": {
              "type": "string",
              "enum": [
                "MODIFIER_REPLACEMENT",
                "TOKEN_REPLACEMENT",
                "RESOURCE_ADDITION",
                "CODE_REMOVAL",
                "LAMBDA_BINDING",
                "DIFF_PATCH"
              ]
            },
            "targetFile": { "type": ["string", "null"] },
            "targetLineRange": {
              "type": ["object", "null"],
              "properties": {
                "start": { "type": "integer" },
                "end": { "type": "integer" }
              }
            },
            "suggestedReplacement": { "type": ["string", "null"] },
            "diff": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
